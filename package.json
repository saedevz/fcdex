{
  "name": "fcdex-core",
  "version": "0.1.0",
  "private": true,
  "description": "FCDex Discord bot core",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bunx tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "setup": "bun scripts/setup.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.7.2",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1"
  }
}