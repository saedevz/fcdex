{
  "name": "fcdex-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FCDex Discord bot core",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch --smol src/index.ts",
    "start": "bun --smol dist/index.js",
    "build": "bunx tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "setup": "bun src/config/setup.ts",
    "deploy": "bun src/deploy-commands.ts",
    "db:generate": "prisma generate",
    "db:push": "bun src/db/import/index.ts prisma/schema.sql",
    "db:import": "bun src/db/import/index.ts",
    "check": "bun run lint && bun run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@prisma/client": "7.10.1",
    "discord.js": "14.27.0",
    "prisma-pglite": "3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
