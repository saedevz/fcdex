# Discord OAuth2 secret for the admin panel (NOT the bot token)
FCDEX_ADMIN_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_CLIENT_SECRET

# At least 32 random characters. Keep this private and stable between restarts.
FCDEX_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Must exactly match a Redirect URI configured in Discord Developer Portal.
# For local development:
FCDEX_ADMIN_REDIRECT_URI=http://127.0.0.1:3030/admin/api/auth/callback

# Admin HTTP listener. Use 127.0.0.1 locally. In a container/reverse-proxy setup,
# set FCDEX_ADMIN_HOST=0.0.0.0 and restrict access at the proxy/firewall.
FCDEX_ADMIN_HOST=127.0.0.1
FCDEX_ADMIN_PORT=3030

# Optional public HTTPS origin when running behind a reverse proxy.
# FCDEX_ADMIN_PUBLIC_ORIGIN=https://admin.example.com
